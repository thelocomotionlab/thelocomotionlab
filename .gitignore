# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo-wide ignores (patterns volontairement non ancrés : ils s'appliquent
# aussi bien à la racine qu'à apps/* et packages/*).

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# turborepo
.turbo

# next.js / builds
.next/
out/
build/
dist/

# testing
coverage/

# cloudflare pages / vercel / wrangler
.vercel
.wrangler

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (jamais de secret dans le repo — cf. docs/secrets.md)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# python (service moteur twin-engine)
.venv/
.venv-*/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/
services/twin-engine/examples/
