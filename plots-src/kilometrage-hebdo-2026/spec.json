{
  "data": [
    {
      "type": "bar",
      "name": "Kilométrage",
      "x": "@semaine",
      "y": "@km",
      "marker": {
        "color": "#8CB9BD",
        "line": { "color": "#5d8f93", "width": 1 }
      },
      "hovertemplate": "<b>%{y:.2f} km</b><extra></extra>"
    },
    {
      "type": "scatter",
      "mode": "lines+markers",
      "name": "Dénivelé positif",
      "x": "@semaine",
      "y": "@deniv",
      "yaxis": "y2",
      "line": { "color": "#B67352", "width": 2 },
      "marker": {
        "color": "#B67352",
        "size": 6,
        "line": { "color": "white", "width": 1 }
      },
      "hovertemplate": "<b>%{y:.0f} m D+</b><extra></extra>"
    }
  ],
  "layout": {
    "yaxis": {
      "title": { "text": "Kilométrage (km)" },
      "rangemode": "tozero"
    },
    "yaxis2": {
      "title": { "text": "Dénivelé positif (m)" },
      "overlaying": "y",
      "side": "right",
      "rangemode": "tozero"
    },
    "showlegend": false,
    "hovermode": "x unified"
  }
}
