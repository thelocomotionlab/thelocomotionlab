# Cloudflare Pages — en-têtes du studio.
#
# LA SEULE SOURCE D'EN-TÊTES : le studio est un export statique, Pages sert tout
# — pages et fichiers — depuis out/, et un `headers()` de next.config.ts n'y
# existerait pas. Le `noindex` vaut pour TOUT ce qui sort de ce domaine : c'est
# une app qui n'est liée de nulle part et n'a rien à faire dans un index.

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Les bundles portent leur empreinte dans leur nom : un an, immuables. Sans ce
# bloc, Pages les fait revalider à chaque visite.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Le logo et les icônes ne bougent pas. Trente jours, pas un an : leurs noms ne
# portent pas d'empreinte, donc un visuel remplacé garde son adresse.
/images/*
  Cache-Control: public, max-age=2592000

# Le service worker, lui, doit être RE-DEMANDÉ à chaque visite : c'est par lui
# qu'une nouvelle version arrive, et un sw en cache fige le studio sur l'ancienne.
/sw.js
  Cache-Control: no-cache
