{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "deploy:cf": "npx @cloudflare/next-on-pages && npx wrangler pages deploy .vercel/output/static --project-name=thelocomotionlab-website",
    "deploy:staging": "npx @cloudflare/next-on-pages && npx wrangler pages deploy .vercel/output/static --project-name=thelocomotionlab-website --branch=staging",
    "test": "vitest run",
    "build:track": "node scripts/build-reference-track.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "live:archiver": "node scripts/live-archiver.mjs",
    "live:preview": "node scripts/live-preview.mjs",
    "carte:partage": "node scripts/carte-partage.mjs"
  },
  "dependencies": {
    "@locomotionlab/tracking": "workspace:*",
    "@locomotionlab/ui": "workspace:*",
    "@tmcw/togeojson": "^7.1.2",
    "gray-matter": "^4.0.3",
    "heic2any": "0.0.4",
    "katex": "^0.16.25",
    "lucide-react": "^0.554.0",
    "maplibre-gl": "^5.13.0",
    "next": "^16.1.1",
    "plotly.js-dist-min": "^3.5.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-footnotes": "^4.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.17",
    "vitest": "4.1.10"
  }
