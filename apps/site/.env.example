# apps/site/.env.example — MODÈLE. Copie-le en `apps/site/.env.local` (git-ignoré)
# et renseigne les valeurs si besoin.
#
#   cp apps/site/.env.example apps/site/.env.local
#
# ⚠️ N'écris JAMAIS de secret ici. Ces variables NEXT_PUBLIC_* sont inlinées dans
# le bundle CLIENT au build → uniquement des valeurs PUBLIQUES (URL, jamais de token).

# === Proxy du live-tracking ===
# Base URL du proxy qui sert les JSON live (live-positions.json / live-timer.json),
# côté back VPS. Le client n'envoie AUCUN token : c'est le proxy (Caddy) qui injecte
# le Bearer Traccar côté serveur. Laisse vide pour conserver le comportement
# historique (la directive <livetracking apiBase="…"> ou le domaine de prod).
#
# Exemple (bascule vers le nouveau back / un domaine de suivi dédié) :
#   NEXT_PUBLIC_TRACKING_PROXY=https://tracking.thelocomotionlab.com
NEXT_PUBLIC_TRACKING_PROXY=

# URL de la passerelle de capture email (services/email-gateway, Worker Cloudflare).
# NON DÉFINI → l'ANCIEN Worker send-email reste utilisé (flux historique intact).
# La bascule vers Listmonk = renseigner cette URL puis rebuild — aucun changement de code.
# Ex. : NEXT_PUBLIC_EMAIL_ENDPOINT=https://email-gateway.<compte>.workers.dev/subscribe
NEXT_PUBLIC_EMAIL_ENDPOINT=

# === Ateliers (page Pratiquer) ===
# Base URL de l'API d'inscription aux ateliers (services/atelier-api, derrière
# Caddy). NON DÉFINI → compteurs statiques du build + inscription via le flux
# email (aucune casse). La bascule = renseigner l'URL puis rebuild.
# Ex. : NEXT_PUBLIC_ATELIER_API=https://api.thelocomotionlab.com/ateliers
NEXT_PUBLIC_ATELIER_API=

# === Cohorte Twin (page /outils/twin/cohorte) ===
# Base URL de l'API de dépôt d'archives (services/twin-depot, derrière Caddy).
# NON DÉFINI → la page s'affiche mais l'envoi renvoie vers /contact (aucune
# casse). La bascule = renseigner l'URL puis rebuild.
# Ex. : NEXT_PUBLIC_TWIN_DEPOT_API=https://api.thelocomotionlab.com/twin
NEXT_PUBLIC_TWIN_DEPOT_API=

# === Live ===
# État de la page /live au build : "avant" (défaut), "encours" ou "termine".
# Lu par lib/liveConfig.js (surchargeable au build, ex. pendant une aventure).
NEXT_PUBLIC_LIVE_STATUT=

# Base URL de l'API du journal de bord (services/live-journal, derrière Caddy).
# Défaut si vide : https://api.thelocomotionlab.com (lib/liveConfig.js).
NEXT_PUBLIC_JOURNAL_API=
