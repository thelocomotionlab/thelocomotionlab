# Route Traccar de tracking.thelocomotionlab.com (ACTIVE).
#
# Reproduit FIDÈLEMENT la conf nginx complète (relevée via `sudo nginx -T`). Caddy sert :
#   • l'UI Traccar (proxy vers l'hôte :8082) ;
#   • /api/public/* (réécriture /api/ + Bearer injecté + CORS) ;
#   • les live-*.json depuis le volume partagé /srv/live (produits par tracking-cache).
# Prend effet quand Caddy tourne en 80/443 (cf. runbook étape 4) et que le montage
# `live_json:/srv/live:ro` est actif dans infra/compose.yml.
# Vérif config : `docker compose exec caddy caddy validate --config /etc/caddy/Caddyfile`.
#
# Différences VOULUES avec l'ancienne conf nginx :
#   • le token n'est plus EN DUR : il vient de {$TRACCAR_API_TOKEN} (infra/.env, non versionné) ;
#   • live-stats.json n'est plus servi (déprécié, plus produit, plus consommé).
#
# Rappels d'équivalence nginx → Caddy :
#   • Caddy préserve le Host entrant et pose X-Forwarded-For/Proto/Host par défaut
#     (≈ proxy_set_header Host $host / X-Real-IP / X-Forwarded-For) ;
#   • la redirection HTTP→HTTPS (nginx `error_page 497`) est automatique chez Caddy ;
#   • nginx n'hérite PAS des add_header de niveau serveur dans une location qui a ses propres
#     add_header → on applique donc la CSP UNIQUEMENT à l'UI, et la CORS uniquement aux routes API
#     / live-json, comme l'effet réel de la conf nginx.

{$TRACKING_DOMAIN} {
	encode zstd gzip

	# === Fichiers live-tracking (produits par le service tracking-cache) ===
	# Servis en lecture seule depuis le volume partagé (compose : live_json:/srv/live:ro).
	# live-stats.json a été DÉPRÉCIÉ (plus produit, plus consommé) → on ne sert que
	# live-positions.json (carte + profil) et live-timer.json (chrono).
	# Lecture seule stricte (équiv. `limit_except GET { deny all; }`).
	@livejson_notget {
		path /live-positions.json /live-timer.json
		not method GET
	}
	handle @livejson_notget {
		respond 403
	}
	@livejson path /live-positions.json /live-timer.json
	handle @livejson {
		header Access-Control-Allow-Origin "*"
		header Cache-Control "no-cache, no-store, must-revalidate"
		root * /srv/live
		file_server
	}

	# === Préflight CORS de l'API publique → 204 immédiat (équiv. `if ($request_method = OPTIONS)`) ===
	@public_options {
		method OPTIONS
		path /api/public/*
	}
	handle @public_options {
		header {
			Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
			Access-Control-Allow-Headers "Origin, Content-Type, Accept, Authorization"
			Access-Control-Allow-Credentials "true"
			Access-Control-Max-Age "86400"
		}
		respond 204
	}

	# === API publique sans login : /api/public/* → Traccar /api/* (Bearer injecté + CORS) ===
	# `uri replace` = équiv. de `rewrite ^/api/public/(.*)$ /api/$1`.
	# `-Set-Cookie` / `-WWW-Authenticate` = équiv. de `proxy_hide_header`.
	@public path /api/public/*
	handle @public {
		uri replace /api/public/ /api/
		header {
			Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
			Access-Control-Allow-Headers "Origin, Content-Type, Accept, Authorization"
			Access-Control-Allow-Credentials "true"
			-Set-Cookie
			-WWW-Authenticate
		}
		reverse_proxy host.docker.internal:8082 {
			header_up Authorization "Bearer {$TRACCAR_API_TOKEN}"
		}
	}

	# === Interface Traccar (login requis) + CSP (équiv. add_header serveur hérité par `location /`) ===
	handle {
		header Content-Security-Policy "default-src 'self'; connect-src 'self' data: blob: https://tile.openstreetmap.org https://a.tile.openstreetmap.org https://b.tile.openstreetmap.org https://c.tile.openstreetmap.org; img-src 'self' data: blob: https://tile.openstreetmap.org https://a.tile.openstreetmap.org https://b.tile.openstreetmap.org https://c.tile.openstreetmap.org; media-src 'self' data: blob: https://tile.openstreetmap.org https://a.tile.openstreetmap.org https://b.tile.openstreetmap.org https://c.tile.openstreetmap.org; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' blob:; style-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net;"
		reverse_proxy host.docker.internal:8082
	}
}
