# Route API du VPS : {$API_DOMAIN} (api.thelocomotionlab.com) — UN préfixe par service.
# Aujourd'hui : /journal/* → live-journal, /ateliers/* → atelier-api, /twin/* → twin-engine.
# Les futurs services s'ajoutent ICI avec leur propre préfixe (pas de nouveau fichier :
# Caddy n'accepte qu'un bloc par adresse de site).
#
# Architecture voulue (validée au plan PR1) : Caddy sert DIRECTEMENT les fichiers
# publics depuis le volume `live_journal_data` (montage /srv/journal:ro dans
# infra/compose.yml) — Range, cache, compression. Le service Node ne reçoit que
# l'API (webhook Telegram, message visiteur, healthcheck). Si le service tombe,
# la LECTURE du journal et des médias reste en ligne.
# Vérif config : `docker compose exec caddy caddy validate --config /etc/caddy/Caddyfile`.

{$API_DOMAIN} {
	encode zstd gzip

	# === /journal — fichiers publics (volume, lecture seule stricte : GET only) ===
	@journal_static_notget {
		path /journal/journal.json /journal/media/*
		not method GET
	}
	handle @journal_static_notget {
		respond 403
	}

	# journal.json : cache court + CORS ouvert — même pattern que les live-*.json
	# de tracking (le front sonde en polling avec cache-buster).
	@journal_json path /journal/journal.json
	handle @journal_json {
		uri strip_prefix /journal
		header Access-Control-Allow-Origin "*"
		header Cache-Control "no-cache, no-store, must-revalidate"
		root * /srv/journal/public
		file_server
	}

	# Médias : noms non devinables et JAMAIS réécrits (une correction = un nouveau
	# fichier) → cache long immuable. file_server gère les requêtes Range (audio iOS).
	@journal_media path /journal/media/*
	handle @journal_media {
		uri strip_prefix /journal
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/journal/public
		file_server
	}

	# Carte de partage og.png (PR4) : URL STABLE régénérée par le service toutes
	# les ~3 min sur le volume → cache court (les scrapers re-crawlent librement).
	@journal_og path /journal/og.png
	handle @journal_og {
		uri strip_prefix /journal
		header Cache-Control "no-cache"
		root * /srv/journal/public
		file_server
	}

	# === /journal — API proxifiée vers le service ===
	# Le CORS de /journal/message est géré PAR LE SERVICE (allowlist d'origines) ;
	# le webhook est protégé par X-Telegram-Bot-Api-Secret-Token côté service ;
	# story.png est générée à la demande (garde-fou de débit côté service).
	@journal_api path /journal/telegram/webhook /journal/message /journal/healthz /journal/story.png
	handle @journal_api {
		reverse_proxy live-journal:3000
	}

	# === /ateliers — inscriptions aux ateliers (page Pratiquer du site) ===
	# CORS géré PAR LE SERVICE : GET /ateliers/places ouvert (décompte public),
	# POST /ateliers/inscriptions restreint aux origines du site ; les routes
	# admin (listing/purge) exigent le Bearer ATELIER_ADMIN_TOKEN côté service.
	@ateliers path /ateliers/places /ateliers/inscriptions /ateliers/inscriptions/* /ateliers/healthz
	handle @ateliers {
		reverse_proxy atelier-api:3000
	}

	# === /twin/* — moteur Locomotion Twin =====================================
	# TROIS familles de chemins sortent, et elles seules :
	#
	#   /twin/tableau-de-bord/*  l'outil de Valentin — jeton Bearer TWIN_ADMIN_TOKEN
	#                            côté service, ET Cloudflare Access devant les PAGES
	#                            (thelocomotionlab.com/services/twin/tableau-de-bord*).
	#   /twin/plans/*            la page d'un athlète — une clé HMAC dans le lien (?k=).
	#                            Mauvaise clé ou référence inconnue : 404, jamais 403.
	#   /twin/jobs/*             l'état d'un passage, que les deux écrans sondent.
	#
	# Ce qui NE sort pas : l'ingestion, les archives, /twin/internal/* (le dépôt
	# prévient le moteur par le réseau Docker) et /preview, /jobs (POST), /fiche —
	# `handle` ne laisse passer que ce qui est listé, le reste tombe sur le 404 final.
	#
	# `uri strip_prefix /twin` : le moteur sert /tableau-de-bord/*, /plans/* et
	# /jobs/* — c'est ce qui réconcilie les chemins du récapitulatif §5 avec ceux de
	# l'internet. CORS géré PAR LE SERVICE (allowlist twin.config.json, bloc api),
	# comme /ateliers et /journal/message.
	#
	# ADRESSE DU VISITEUR : le moteur compte les essais de clé par adresse, et cette
	# adresse doit être celle du visiteur, pas celle du proxy — sinon la limite est
	# globale et le premier venu ferme la porte à tout le monde. Ce sous-domaine est
	# PROXIFIÉ par Cloudflare (nuage orange), qui pose CF-Connecting-IP et l'écrase à
	# chaque passage : c'est cet en-tête que le service lit en premier, comme
	# atelier-api. X-Forwarded-For ne sert que de repli, et n'est digne de foi QUE
	# parce que rien n'atteint Caddy sans passer par Cloudflare (docs/cloudflare-vps.md).
	#
	# Vérif : `docker compose exec caddy caddy validate --config /etc/caddy/Caddyfile`.

	@twin path /twin/tableau-de-bord/* /twin/plans/* /twin/jobs/*
	handle @twin {
		# Un corps de cette API est du JSON de réglages, une trace GPX ou un dossier de
		# rapport (~200 Kio). Les archives d'entraînement, elles, ne passent pas par
		# ici : elles entrent par {$DEPOT_DOMAIN} et le moteur va les chercher tout seul
		# sur le réseau Docker. Cette borne double celle du service.
		request_body {
			max_size 32MiB
		}
		uri strip_prefix /twin
		reverse_proxy twin-engine:8000
	}

	handle {
		respond 404
	}
}
