# infra/.env.example — MODÈLE. Copie-le en `infra/.env` et renseigne les valeurs.
#
#   cp infra/.env.example infra/.env
#
# ⚠️ `infra/.env` est git-ignoré (cf. .gitignore : `.env*` sauf `.env.example`). N'écris JAMAIS
# de secret dans CE fichier-ci. Référence des secrets : docs/secrets.md.

# === Cloudflare — DNS-01 (émission/renouvellement des certificats Let's Encrypt par Caddy) ===
# Token API Cloudflare SCOPÉ (dashboard → My Profile → API Tokens → Create Token) :
#   • Permissions : Zone > DNS > Edit  ET  Zone > Zone > Read
#   • Zone Resources : Include > Specific zone > thelocomotionlab.com
# Procédure détaillée : docs/cloudflare-vps.md.
CF_API_TOKEN=

# Email de contact Let's Encrypt (avis d'expiration / problème de renouvellement).
ACME_EMAIL=

# === Traccar — Bearer token de l'API ===
# Utilisé par (1) Caddy pour /api/public/* à la bascule, et (2) le service tracking-cache
# pour interroger /positions. Secret du VPS — JAMAIS dans le repo. À RÉGÉNÉRER (l'ancien a fuité).
TRACCAR_API_TOKEN=

# URL de l'API Traccar vue depuis le conteneur tracking-cache. Par défaut, Traccar EN LOCAL
# sur l'hôte (pas d'aller-retour public). Laisse tel quel sauf besoin particulier.
TRACCAR_API_URL=http://host.docker.internal:8082/api

# Override ponctuel de l'appareil suivi (sinon : deviceId de
# services/tracking-cache/tracking.config.json). Cf. docs/live-tracking-guide.md § changer d'appareil.
# DEVICE_ID=8

# === Image du back live-tracking (construite en CI, poussée sur GHCR) ===
TRACKING_CACHE_IMAGE=ghcr.io/thelocomotionlab/tracking-cache:latest

# === Image du moteur Locomotion Twin (Python/FastAPI + TeXLive, construite en CI) ===
TWIN_ENGINE_IMAGE=ghcr.io/thelocomotionlab/twin-engine:latest

# === Domaines servis par Caddy ===
TEMPLATE_DOMAIN=template.thelocomotionlab.com
TRACKING_DOMAIN=tracking.thelocomotionlab.com
# Listmonk (liste email du Lab) — cf. docs/email-setup.md.
LISTE_DOMAIN=liste.thelocomotionlab.com
# Moteur Twin : INTERNE par défaut (pas de route publique). Décommente UNIQUEMENT si tu
# actives caddy/conf.d/twin-engine.caddy (retrait du .disabled) pour l'exposer.
# TWIN_ENGINE_DOMAIN=twin-engine.thelocomotionlab.com

# === Live-journal (journal de bord du direct — chantier 2) ===
# Domaine API servi par Caddy : les fichiers publics et l'API du journal vivent
# sous api.thelocomotionlab.com/journal/ (cf. caddy/conf.d/api.caddy).
API_DOMAIN=api.thelocomotionlab.com
# Sous-domaine PUBLIC redirigé en 301 vers thelocomotionlab.com/live
# (cf. caddy/conf.d/live-redirect.caddy). DNS Cloudflare proxifié à créer pour les deux.
LIVE_DOMAIN=live.thelocomotionlab.com
# Dépôt d'archives de la cohorte Twin (cf. caddy/conf.d/depot.caddy). ⚠ DNS Cloudflare
# en « DNS only » (nuage GRIS), PAS proxifié : le proxy plafonne les uploads à ~100 Mo,
# une archive d'entraînement en fait couramment plusieurs centaines.
DEPOT_DOMAIN=depot.thelocomotionlab.com
# Image (construite en CI, poussée sur GHCR). PENDANT L'AVENTURE : épingle une
# révision précise (`...live-journal:sha-xxxxxxx`) — pas de :latest surprise.
LIVE_JOURNAL_IMAGE=ghcr.io/thelocomotionlab/live-journal:latest
# Token du bot Telegram du journal (BotFather). SECRET — jamais dans le repo.
TELEGRAM_BOT_TOKEN=
# Secret du webhook (invente : `openssl rand -hex 32`). Telegram le renvoie dans
# l'en-tête X-Telegram-Bot-Api-Secret-Token ; le service refuse tout le reste.
# Enregistrement du webhook : services/live-journal/scripts/set-webhook.sh.
TELEGRAM_WEBHOOK_SECRET=
# chat_id Telegram de Valentin (le bot @userinfobot le donne) : SEULE source
# autorisée du journal, et destinataire des messages privés des visiteurs.
VALENTIN_CHAT_ID=
# Base PUBLIQUE du site, consultée par live-journal pour générer la carte OG
# (il lit {SITE_BASE}/live-config.json). Défaut : https://thelocomotionlab.com.
# ⚠ PHASE STAGING : tant que le site vit sur l'URL de staging Pages, pointe la
# variable vers elle, sinon la carte OG reste « neutre » (cf. docs/plan-staging.md).
# À retirer (ou repasser au défaut) au lancement officiel.
# SITE_BASE=https://staging.thelocomotionlab-website.pages.dev

# === Ateliers (service atelier-api — inscriptions page Pratiquer) ===
# Jeton des routes admin (listing + purge des inscriptions) : invente une
# valeur longue (`openssl rand -hex 24`). Vide → routes admin désactivées.
ATELIER_ADMIN_TOKEN=
# Image épinglable comme les autres (sinon :latest).
# ATELIER_API_IMAGE=ghcr.io/thelocomotionlab/atelier-api:latest
# SMTP de l'email récapitulatif (PDF de la fiche) — même relais que la liste
# (Brevo : docs/email-setup.md §3, SMTP & API → SMTP). SMTP_HOST vide →
# envoi désactivé, l'inscription reste fonctionnelle.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Locomotion Lab <contact@thelocomotionlab.com>"
# Rendu PDF de la fiche par twin-engine (réseau docker interne). Laisser tel
# quel ; vide → PDF désactivé.
TWIN_ENGINE_URL=http://twin-engine:8000

# === Cohorte Twin (service twin-depot — dépôt d'archives, page /outils/twin/cohorte) ===
# Jeton des routes admin (listing + téléchargement + purge des dépôts) : invente
# une valeur longue (`openssl rand -hex 24`). Vide → routes admin désactivées.
TWIN_DEPOT_ADMIN_TOKEN=
# Destinataire de la notification « nouveau dépôt » (best-effort, via le SMTP
# ci-dessus). Vide → notification désactivée. Le même SMTP sert aussi l'email
# de CONFIRMATION au déposant (destinataire = l'adresse du formulaire ;
# SMTP_HOST vide → aucun des deux ne part, le dépôt reste fonctionnel).
TWIN_DEPOT_NOTIFY_EMAIL=
# Image épinglable comme les autres (sinon :latest).
# TWIN_DEPOT_IMAGE=ghcr.io/thelocomotionlab/twin-depot:latest

# === Listmonk (liste email auto-hébergée) ===
# Mot de passe de la base PostgreSQL interne (invente une valeur longue, ex. `openssl rand -hex 24`).
LISTMONK_DB_PASSWORD=
# Compte admin de l'interface Listmonk, créé au PREMIER démarrage seulement
# (ensuite, changement de mot de passe dans l'UI : Admin → Users).
LISTMONK_ADMIN_USER=
LISTMONK_ADMIN_PASSWORD=

# === Image applicative (construite en CI, poussée sur GHCR) ===
# Épingle une révision précise (`...template:sha-xxxxxxx`) pour un déploiement reproductible /
# un rollback ; `:latest` suit la dernière build.
TEMPLATE_IMAGE=ghcr.io/thelocomotionlab/template:latest

# === Ports hôte exposés par Caddy ===
# VALIDATION (par défaut) : ports alternatifs → cohabite avec nginx/Traccar (80/443 intacts).
# ⚠️ Choisis des ports LIBRES : vérifie avec `sudo ss -tlnp | grep -E ':(8081|8443)\b'`.
#    (8080 est souvent déjà pris — p. ex. par code-server.)
HTTP_PORT=8081
HTTPS_PORT=8443
# BASCULE (étape 4) : commente les deux lignes ci-dessus et décommente celles-ci pour que Caddy
# prenne 80/443 (APRÈS avoir libéré nginx — cf. runbook).
# HTTP_PORT=80
# HTTPS_PORT=443
