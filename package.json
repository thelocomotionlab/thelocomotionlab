{
  "name": "thelocomotionlab-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:site": "pnpm -F site dev",
    "build:site": "pnpm -F site build",
    "lint:site": "pnpm -F site lint",
    "deploy:site": "pnpm -F site deploy:cf",
    "deploy:site:staging": "pnpm -F site deploy:staging",
    "ship": "bash scripts/ship.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-react-hooks": "7.0.1"
    }
  }
}
