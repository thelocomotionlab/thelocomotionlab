{
  "//": "Paramètres NON SECRETS du service live-journal, versionnés. Chaque clé est surchargeable par variable d'environnement (cf. src/config.ts). Les secrets (TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, VALENTIN_CHAT_ID) ne vivent QUE dans l'environnement (infra/.env sur le VPS).",
  "port": 3000,
  "publicPrefix": "/journal",
  "allowedOrigins": [
    "https://thelocomotionlab.com",
    "https://www.thelocomotionlab.com",
    "https://staging.thelocomotionlab-website.pages.dev",
    "https://thelocomotionlab-staging.pages.dev",
    "http://localhost:3000"
  ],
  "message": {
    "maxMessageLength": 1000,
    "maxPrenomLength": 50,
    "maxEmailLength": 254,
    "ratePerMinute": 5,
    "ratePerHour": 30
  },
  "media": {
    "photoMaxWidth": 1600,
    "photoQuality": 80,
    "maxDownloadBytes": 20971520
  },
  "videoEnabled": false,
  "og": {
    "enabled": true,
    "intervalMinutes": 3
  },
  "siteBase": "https://thelocomotionlab.com",
  "trackingBase": "https://tracking.thelocomotionlab.com",
  "selfCheck": {
    "enabled": true,
    "intervalMinutes": 30,
    "diskMinMb": 500
  }
}
