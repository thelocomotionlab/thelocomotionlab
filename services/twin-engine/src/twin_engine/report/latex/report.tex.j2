% Gabarit du rapport Locomotion Twin v3 (classe locomotionreport, Ubuntu Sans).
% Délimiteurs Jinja : chevrons doubles (variables), chevron-pourcent (blocs), chevron-dièse
% (commentaires) — rendu par twin_engine.report.render. Couverture · ta course · le plan ·
% ton profil et la preuve. La feuille à emporter est un document à part (feuille.tex.j2).
% Aucun chiffre en dur : tout vient du contexte calculé (tests/test_report_v3.py le vérifie
% entre les marqueurs LL:BEGIN / LL:END).
\documentclass{locomotionreport}

\captionsetup{justification=raggedright, singlelinecheck=false}
\addbibresource{references.bib}

\LLheaddoc{<< race_name >>}

\begin{document}

% =====================================================================
% LL:BEGIN couverture
\LLcouverture
  {Plan de course \textperiodcentered{} << report_date >>}
  {<< race_name >>}
  {Pour \textbf{<< athlete >>} \textperiodcentered{} << length_km >>\,km \textperiodcentered{}
   << dplus_m >>\,m\,D+ \textperiodcentered{} << dminus_m >>\,m\,D−<% if start_time %>\\
   Départ << start_time >><% endif %>}
  {%
    {\fontsize{16}{23}\selectfont\color{LLText}%
<% if plan_low %>    Tu arrives autour de \textbf{<< pred_central >>}<% if arrival_clock %>, le << arrival_clock >><% endif %>.\\
    << plan_band_word|capitalize >> se joue entre \textbf{<< plan_low >>} et \textbf{<< plan_high >>}.
<% else %>    Tu arrives autour de \textbf{<< pred_central >>}<% if arrival_clock %>, le << arrival_clock >><% endif %>.\\
    << safety_word|capitalize >> se joue entre \textbf{<< interval_low >>} et \textbf{<< interval_high >>}.
<% endif %>    \par}
    \vspace{7mm}
    \LLbadge{<< confidence_word >>}{<< confidence_color >>}\par\vspace{3mm}
    {\fontsize{10}{14}\selectfont\color{LLSoft}<< verdict_sentence >>\par}
  }
% LL:END couverture

% =====================================================================
% LL:BEGIN page-course
\LLpage{<% if start_time_short %><< start_time_short >><% else %>Départ à préciser<% endif %>}{Ta course}
\LLfootleft{Le plan segment par segment est page 3 ; la feuille à emporter se détache à part.}

\noindent\begin{minipage}[t]{0.235\linewidth}\LLtile{<% if target_mode %>Au plus tôt<% else %>Rapide<% endif %>}{<< plan_low >>}{<% if arrival_fast_clock %><< arrival_fast_clock >><% else %>départ à préciser<% endif %>}\end{minipage}\hfill
\begin{minipage}[t]{0.235\linewidth}\LLtileaccent{<% if target_mode %>Ton objectif<% else %>Prévu<% endif %>}{<< pred_central >>}{<% if arrival_clock %><< arrival_clock >><% else %>départ à préciser<% endif %>}\end{minipage}\hfill
\begin{minipage}[t]{0.235\linewidth}\LLtile{<% if target_mode %>Au plus tard<% else %>Prudent<% endif %>}{<< plan_high >>}{<% if arrival_cautious_clock %><< arrival_cautious_clock >><% else %>départ à préciser<% endif %>}\end{minipage}\hfill
\begin{minipage}[t]{0.255\linewidth}\LLtilecrew{Pour l'assistance}{<% if arrival_safety_lo_clock %><< arrival_safety_lo_clock >>\LLfleche << arrival_safety_hi_clock >><% else %><< interval_low >>\LLfleche << interval_high >><% endif %>}{<< safety_word >>}\end{minipage}

\vspace{14pt}
\noindent\includegraphics[width=\linewidth]{figures/profil.png}

\vspace{6pt}
\noindent\begin{minipage}[t]{0.47\linewidth}
  \LLetiquette{Le parcours}\par\vspace{3pt}
  << length_km >>\,km et << dplus_m >>\,m de D+ font \textbf{<< deq_km >>\,km à plat} une fois la pente convertie en effort.<% if technicity_pct %> Technicité déclarée : +<< technicity_pct >>\,\%.<% endif %>
\end{minipage}\hfill
\begin{minipage}[t]{0.47\linewidth}
  \LLetiquette{Ce qui décidera}\par\vspace{3pt}
<% if vc_fraction_pct %>  Environ << vc_fraction_pct >>\,\% de ta vitesse critique<% if vc_low %> : la vitesse ne sera pas le sujet, l'endurance et le ravitaillement décideront<% else %> : la régularité et la durabilité décideront<% endif %>.
<% else %>  Une allure très loin de tout seuil : l'endurance, la durabilité et le ravitaillement décideront.
<% endif %>  Mouvement << t_move_h >> + arrêts << stops.hours_hm >> = horloge \textbf{<< t_clock_h >>}.
\end{minipage}

\vspace{6pt}
\begin{llverdict}[Confiance]
\LLbadge{<< confidence_word >>}{<< confidence_color >>}\par\vspace{5pt}
<< verdict_sentence >>\par\vspace{4pt}
<< honesty >><% if width_prescription %>\par\vspace{3pt}<< width_prescription >><% endif %>
\end{llverdict}
% LL:END page-course

% =====================================================================
% LL:BEGIN page-plan
\LLpage{Segment par segment}{Le plan}
\LLfootleft{Mouvement << t_move_h >> + arrêts << stops.hours_hm >> = horloge << t_clock_h >>.}

Tu vises une vitesse \emph{ajustée à la pente} constante : ralentir en montée, accélérer en
descente, au même coût. Le plan part au-dessus de ta moyenne et finit en dessous
($-$<< fade_pct >>\,\% du début à la fin), parce que << fade_evidence >>.
<% if target_mode %>Le temps réparti ici est \textbf{ton objectif} (<< target_hm >>), pas la
prédiction : les fenêtres sont une tolérance d'exécution de $\pm$<< target_tolerance_pct >>\,\%,
pas une probabilité. Pour mémoire, le modèle te situe à \textbf{<< pred_central >>}.
<% endif %>

\textbf{Arrêts.} << stops_policy.sentence >>.
<% if not crew_declared %>
\textbf{Assistance.} La spec de course ne déclare aucun point d'assistance : les lignes teintées
sont \textbf{supposées}, ce sont les bases majeures du parcours. À vérifier au carnet de course
avant de les donner à ton assistance.
<% endif %>
\begin{table}[H]
  \centering \scriptsize \setlength{\tabcolsep}{3.2pt}
  \LLtableau \renewcommand{\arraystretch}{1.5}
  \begin{tabularx}{\linewidth}{|c|>{\centering\arraybackslash}p{26mm}|c|c|c|c|c|c|c|>{\centering\arraybackslash}X|}
    \hline
    \LLheaderrow
    \LLthead{\#} & \LLthead{Vers} & \LLthead{km} & \LLthead{D+} & \LLthead{D−} & \LLthead{allure} & \LLthead{<< clock_titles.fast >>} & \LLthead{<< clock_titles.central >>} & \LLthead{<< clock_titles.cautious >>} & \LLthead{Sur ce segment} \\
    \hline
<% for s in feuille_rows %><% if s.contact %>    \LLassist
<% endif %>    << s.idx >> & << s.to >> & \LLnum{<< s.km >>} & <% if s.strong_dplus %>\LLfort{<< s.dplus >>}<% else %>\LLnum{<< s.dplus >>}<% endif %> & <% if s.strong_dminus %>\LLfort{<< s.dminus >>}<% else %>\LLnum{<< s.dminus >>}<% endif %> & \LLnum{<< s.pace >>} & \LLnum{<% if s.fast.day %><< s.fast.day >> <% endif %><< s.fast.hour >>} & \LLprevu{\LLnum{<% if s.central.day %><< s.central.day >> <% endif %><< s.central.hour >>}} & \LLnum{<% if s.cautious.day %><< s.cautious.day >> <% endif %><< s.cautious.hour >>} & << s.marche >> \\
    \hline
<% endfor %>  \end{tabularx}
  \caption{Les trois colonnes sont titrées par leur heure d'arrivée : repère tôt celle qui te correspond et suis-la. Les lignes teintées sont les ravitaillements ouverts à ton assistance.<% if target_mode %> Autour d'un objectif, ce sont les bornes d'une fenêtre de passage — une tolérance d'exécution de $\pm$<< target_tolerance_pct >>\,\%, pas une probabilité.<% else %> Entre la première et la dernière, << plan_band_word >>.<% endif %>}
\end{table}

\begin{figure}[H]
  \centering
  \includegraphics[width=\linewidth]{figures/cumul.png}
  \caption{<< caption_cumul >>}
\end{figure}
<% if target_requested %>
\LLtitre{Ton objectif face à ton jumeau}
Tu as demandé un plan pour \textbf{<< target_hm >>} : \textbf{<< target_regime_label >>}.
Il faudrait tenir \LLnum{<< target_required_v >>}\,km/h ajustés<% if target_vc_pct %>, soit
<< target_vc_pct >>\,\% de ta vitesse critique<% endif %><% if target_gap_pct %>, ce qui te situe
<< target_gap_pct >>\,\% plus <% if target_faster_than_central %>rapide<% else %>lent<% endif %>
que la prédiction<% endif %>.
<% if not target_plan_ok %>\begin{llattention}[Pas de plan sur cet objectif]
Cette cible sort de ce que tes données permettent : un plan calé dessus ferait partir trop vite
et coûterait la fin de course. Le plan ci-dessus reste ancré sur la prédiction ; l'écart chiffré
est un objectif d'entraînement pour la saison.
\end{llattention}
<% else %>\begin{llattention}[Ce plan suppose ton objectif tenable]
Il répartit au mieux la durée que tu as choisie en respectant ta courbe de fatigue ; il ne le rend pas tenable. La référence de ce qui est probable reste la prédiction et ses bornes de sécurité.
\end{llattention}
<% endif %><% endif %>
% LL:END page-plan

% =====================================================================
% LL:BEGIN page-profil
\LLpage{La preuve}{Ton profil}
\LLfootleft{Le détail complet — méthode, calibration, plan intégral — est dans l'annexe en ligne.}

<< opening >>

\par\vspace{4pt}
\noindent\begin{minipage}[t]{0.47\linewidth}
<% for g in gauges[:2] %>\LLgauge{<< g.label >>}{<< g.value >>}{<< g.fraction >>}{<< g.sentence >>}
<% endfor %>\end{minipage}\hfill
\begin{minipage}[t]{0.47\linewidth}
<% for g in gauges[2:] %>\LLgauge{<< g.label >>}{<< g.value >>}{<< g.fraction >>}{<< g.sentence >>}
<% endfor %>\end{minipage}

<% if durability_pourtoi %>\par\vspace{-2pt}
<< durability_pourtoi >>\par
<% endif %><% if vc_implausible %>\begin{llattention}[Vitesse critique non affichée]
L'estimation de ta vitesse critique ressort au-dessus du plafond physiologique plausible : elle
trahit des données suspectes plutôt qu'un vrai seuil. Ni sa valeur ni aucun « \% de VC » ne sont
utilisés dans ce rapport ; la prédiction, elle, n'en dépend pas.
\end{llattention}
<% endif %>
\par\vspace{4pt}
\noindent\begin{minipage}{\linewidth}
\begin{minipage}[t]{0.655\linewidth}\vspace{0pt}
<% if vc_kmh %>\includegraphics[width=\linewidth]{figures/record.png}\par\vspace{2pt}
{\fontsize{7.4}{9.4}\selectfont\color{LLSoft}<< caption_record >>\par}
<% endif %>\end{minipage}\hfill
\begin{minipage}[t]{0.305\linewidth}\vspace{0pt}
<% if has_cv %>\includegraphics[width=\linewidth]{figures/validation.png}\par\vspace{2pt}
{\fontsize{7.4}{9.4}\selectfont\color{LLSoft}<< caption_validation >>\par}
<% else %>\LLetiquette{Validation impossible}\par\vspace{3pt}
{\fontsize{8.4}{11}\selectfont\color{LLText}Moins de trois vrais ultras : la validation croisée
n'est pas calculable et la prédiction repose sur une extrapolation (<< regime_label >>). Un ordre
de grandeur, pas une cible ferme.\par}
<% endif %>\end{minipage}
\end{minipage}

\begin{llhonnete}
{\fontsize{9}{12}\selectfont
<% for l in limits_short %>\textbf{<< l.lead >>} \textemdash{} << l.short >><% if not loop.last %>\par<% endif %>
<% endfor %>}\par\vspace{5pt}
{\color{LLHairline}\hrule height 0.4pt}\par\vspace{5pt}
\noindent\begin{minipage}[t]{0.87\linewidth}\vspace{0pt}
  \LLetiquette{Ce que le plan suppose}\par\vspace{2pt}
  {\fontsize{8.2}{10.6}\selectfont\ignorespaces
  <% for a in assumptions %><< a >><% if not loop.last %> <% endif %><% endfor %>
  {\color{LLSoft}Le code ouvre l'annexe en ligne : méthode, calibration course par course,
  validation croisée, plan complet, glossaire et références.}\par}
\end{minipage}\hfill
\begin{minipage}[t]{0.1\linewidth}\vspace{0pt}
  \LLqr{<< annex_url >>}
\end{minipage}
\end{llhonnete}
% LL:END page-profil

\end{document}
