% Gabarit du rapport Locomotion Twin (classe locomotionreport, Ubuntu Sans).
% Délimiteurs Jinja : chevrons doubles (variables), chevron-pourcent (blocs), chevron-dièse
% (commentaires) — rendu par twin_engine.report.render.
%
% Une page de garde et quatre pages, chacune bornée par LL:BEGIN / LL:END : ta course · où
% passe le temps · le plan · ton profil et la preuve. L'ordre des blocs dans ce fichier EST
% l'ordre des pages. Aucun chiffre en dur : tout vient du contexte calculé
% (tests/test_report_v3.py le vérifie page par page). La feuille à emporter et les fiches
% d'assistance sont un document à part (feuille.tex.j2).
\documentclass{locomotionreport}

\captionsetup{justification=raggedright, singlelinecheck=false}
\addbibresource{references.bib}

\LLheaddoc{<< race_name >>}

% Largeurs de la grille du plan : une seule pour les chiffres, une seule pour les heures, et
% la dernière colonne prend exactement ce qui reste — c'est ce qui rend la grille régulière et
% permet de composer TOUTES les colonnes en « m » (centrage vertical), ce que le X de
% tabularx ne sait pas faire.
\newlength{\LLcnum}  \setlength{\LLcnum}{8.8mm}
\newlength{\LLcheure}\setlength{\LLcheure}{17.4mm}
\newlength{\LLcreste}
% \LLgrilleplan : la largeur restante, mesurée APRÈS le \tabcolsep du tableau — sinon elle
% mesure la gouttière par défaut et la dernière colonne se ratatine.
\newcommand{\LLgrilleplan}{%
  \setlength{\LLcreste}{\dimexpr\linewidth - 1.1mm - 4.4mm - 34mm - 3\LLcnum - 12mm
    - 3\LLcheure - 19\tabcolsep - 11\arrayrulewidth\relax}}

% Chaque bloc pose son propre air : le ressaut de paragraphe global ferait
% doublon avec les \vspace des macros de page.
\setlength{\parskip}{0pt}

\begin{document}

% =====================================================================
% LL:BEGIN page-garde
\LLcouverture
  {Plan de course}
  {<< race_name >>}
  {Pour << athlete >>}
  {<< length_km >>\,km \textperiodcentered{} << dplus_m >>\,m\,D+ \textperiodcentered{}
   << dminus_m >>\,m\,D−<% if dplus_officiel %> (<< dplus_officiel >>\,m au carnet de route,
   << dplus_ecart_pct >>\,\%)<% endif %><% if start_time %>\\ Départ << start_time >><% endif %>}
  {Édité le << report_date >>}
  {<< annex_ref >>}
% LL:END page-garde

% =====================================================================
% LL:BEGIN page-course
\LLpage{Ta course}
{\fontsize{10.5}{18}\selectfont\color{LLSoft}Pour \textbf{<< athlete >>} \textperiodcentered{}
<< length_km >>\,km \textperiodcentered{} << dplus_m >>\,m\,D+ \textperiodcentered{}
<< dminus_m >>\,m\,D−<% if start_time %> \textperiodcentered{} départ << start_time >><% endif %>\par}

\vspace{7mm}
\LLbloc{<% if target_mode %>Tu vises<% else %>Tu arrives autour de<% endif %>}\vspace{3mm}
\LLchiffregeant{<% if target_mode %><< target_hm >><% else %><< pred_central >><% endif %>}{<% if arrival_clock %>le << arrival_clock >><% endif %>}
\vspace{4mm}
{\fontsize{14.25}{21}\selectfont\color{LLText}%
<% if target_mode %>Ta fenêtre de passage va de \textbf{<< plan_low >>} à \textbf{<< plan_high >>}. Ton jumeau te situe à \textbf{<< pred_central >>}.
<% elif plan_low %><< plan_band_word|capitalize >> se joue entre \textbf{<< plan_low >>} et \textbf{<< plan_high >>}.
<% else %><< safety_word|capitalize >> se joue entre \textbf{<< interval_low >>} et \textbf{<< interval_high >>}.
<% endif %>\par}

\vspace{6mm}
\LLtuiles{%
  \LLtuile{<% if target_mode %>Au plus tôt<% else %>Rapide<% endif %>}{<< plan_low >>}{<% if arrival_fast_clock %><< arrival_fast_clock >><% else %>départ à préciser<% endif %>}%
  \LLtuilesep
  \LLtuileforte{<% if target_mode %>Ton objectif<% else %>Centrale<% endif %>}{<% if target_mode %><< target_hm >><% else %><< pred_central >><% endif %>}{<% if arrival_clock %><< arrival_clock >><% else %>départ à préciser<% endif %>}%
  \LLtuilesep
  \LLtuile{<% if target_mode %>Au plus tard<% else %>Prudent<% endif %>}{<< plan_high >>}{<% if arrival_cautious_clock %><< arrival_cautious_clock >><% else %>départ à préciser<% endif %>}}

\vspace{7mm}
{\color{LLText}\hrule height 0.4pt}\vspace{7pt}
<% if recit.course %>\LLdefligne{La course}{<< recit.course >>}
<% endif %><% if recit.historique %>\LLdefligne{Ton historique}{<< recit.historique >>}
<% endif %><% if recit.methode %>\LLdefligne{Comment c'est prédit}{<< recit.methode >>}
<% endif %><% if recit.fourchettes %>\LLdeffin{Les fourchettes}{%
  \noindent<% for f in recit.fourchettes %>\begin{minipage}[t]{0.48\linewidth}
    {\LLsemiboldfont\LLtabular\fontsize{12.75}{15}\selectfont\color{LLText}<< f.valeur >>\par}
    \vspace{2pt}{\fontsize{9}{13}\selectfont\color{LLSoft}<< f.phrase >>\par}
  \end{minipage}<% if not loop.last %>\hfill<% endif %><% endfor %>}
<% endif %>% LL:END page-course

% =====================================================================
% LL:BEGIN page-parcours
\LLpage{Le parcours}

\LLbloc{Le profil}\vspace{4mm}
\noindent\includegraphics[width=\linewidth]{figures/profil.png}\par
\vspace{4mm}
{\fontsize{8.25}{12}\selectfont\color{LLSoft}La trame bleu-vert marque les heures de nuit.\par}
<% if faits.ventilation %>
\vspace{9mm}
\LLpanneau{%
  \LLbloc{Le temps prévu}\vspace{4mm}
  \LLbarre{<% for p in faits.ventilation.parts %>\LLtroncon{<< p.fraction >>}{<% if p.cle == 'montee' %>LLDeep<% elif p.cle == 'roulant' %>LLPrimary<% elif p.cle == 'descente' %>LLAccent<% else %>LLHairline<% endif %>}<% endfor %>}
  \vspace{4mm}
  {\fontsize{9.4}{16}\selectfont\noindent<% for p in faits.ventilation.parts %>\begin{minipage}[t]{0.49\linewidth}\LLpuce{<% if p.cle == 'montee' %>LLDeep<% elif p.cle == 'roulant' %>LLPrimary<% elif p.cle == 'descente' %>LLAccent<% else %>LLHairline<% endif %>}<< p.quoi >>\ \textbf{<< p.hm >>}\ {\color{LLSoft}(<< p.pct >>\,\%)}\end{minipage}<% if not loop.last %><% if loop.index % 2 == 0 %>\par\vspace{3mm}<% else %>\hfill<% endif %><% endif %><% endfor %>\par}
<% if faits.ventilation.lecture %>  \vspace{5mm}
  {\fontsize{9.75}{16}\selectfont << faits.ventilation.lecture >>\par}
<% endif %>  \vspace{3mm}
  {\fontsize{8.25}{12}\selectfont\color{LLSoft}<< faits.ventilation.legende >>\par}}
<% endif %>
\vspace{9mm}
\LLbloc{L'heure de passage}\vspace{4mm}
\noindent\includegraphics[width=\linewidth]{figures/cumul.png}\par
\vspace{4mm}
{\fontsize{8.25}{12}\selectfont\color{LLSoft}<< caption_cumul >>\par}
% LL:END page-parcours

% =====================================================================
% LL:BEGIN page-plan
\LLpage{Le plan}

{\fontsize{9.4}{15}\selectfont
Tu vises une vitesse \emph{ajustée à la pente} constante : ralentir en montée, accélérer en
descente, au même coût. Le plan part au-dessus de ta moyenne et finit en dessous
($-$<< fade_pct >>\,\% du début à la fin), parce que << fade_evidence >>.
<% if target_mode %>Le temps réparti ici est \textbf{ton objectif} (<< target_hm >>), pas la
prédiction : les fenêtres sont une tolérance d'exécution de $\pm$<< target_tolerance_pct >>\,\%,
pas une probabilité. Pour mémoire, le modèle te situe à \textbf{<< pred_central >>}.
<% endif %><% if faits.depart %><< faits.depart >>
<% endif %>\textbf{Arrêts.} << stops_policy.sentence >>.
<% if not crew_declared %>\textbf{Assistance.} La spec de course ne déclare aucun point
d'assistance : les lignes à filet sont \textbf{supposées}, ce sont les bases majeures du
parcours. À vérifier au carnet de course avant de les donner à ton assistance.
<% endif %>\par}

\vspace{4mm}
{\fontsize{8.6}{8.6}\selectfont\LLtableau
\setlength{\tabcolsep}{2pt}\renewcommand{\arraystretch}{1.55}
\LLgrilleplan
\begin{tabular}{|@{}>{\LLcell}m{1.1mm}@{}>{\LLcell\color{LLSoft}}m{4.4mm}|>{\LLcellg}m{34mm}|>{\LLcell}m{\LLcnum}|>{\LLcell}m{\LLcnum}|>{\LLcell}m{\LLcnum}|>{\LLcell}m{12mm}|>{\columncolor{LLColRapide}\LLcell\color{LLSoft}}m{\LLcheure}|>{\columncolor{LLColCentrale}\LLcell\LLsemiboldfont}m{\LLcheure}|>{\columncolor{LLColPrudent}\LLcell\color{LLSoft}}m{\LLcheure}|>{\LLcell\fontsize{7.4}{9}\selectfont\color{LLSoft}}m{\LLcreste}|}
  \LLfilet{11}
  & {\color{LLText}\LLtete{\#}} & \LLtete{Vers} & \LLteteindice{km}{tot} & \LLtete{D+} & \LLtete{D−} & \LLtete{allure} & \LLtetehoraire{LLPrimary}{<< clock_titles.fast >>} & \LLtetehoraire{LLDeep}{<< clock_titles.central >>} & \LLtetehoraire{LLAccent}{<< clock_titles.cautious >>} & \LLtete{Sur ce segment} \\
  \LLfilet{11}
<% for s in feuille_rows %>  <% if s.contact %>{\color{LLDeep}\LLmargecrew}<% endif %> & << s.idx >> & \LLnomseg{<% if s.contact %>\LLfort{<< s.to >>}<% else %><< s.to >><% endif %>}{<% if s.night %>\LLnuitpoint<% endif %>} & << s.km >> & <% if s.strong_dplus %>\LLfort{<< s.dplus >>}<% else %><< s.dplus >><% endif %> & <% if s.strong_dminus %>\LLfort{<< s.dminus >>}<% else %><< s.dminus >><% endif %> & << s.pace >> & <% if s.fast.day %><< s.fast.day >> <% endif %><< s.fast.hour >> & <% if s.central.day %><< s.central.day >> <% endif %><< s.central.hour >> & <% if s.cautious.day %><< s.cautious.day >> <% endif %><< s.cautious.hour >> & \LLtient{\linewidth}{\mbox{<< s.marche >>}} \\
  \LLfilet{11}
<% endfor %>\end{tabular}\par}
\LLlegende{Les trois colonnes sont titrées par leur heure d'arrivée : repère tôt celle qui te correspond et suis-la. \LLtraitlegende{LLDeep} Les lignes à filet en marge sont les ravitaillements ouverts à ton assistance ; \LLnuitpoint{} un point d'encre à côté du nom : le segment se court de nuit.<% if target_mode %> Autour d'un objectif, ce sont les bornes d'une
fenêtre de passage — une tolérance d'exécution de $\pm$<< target_tolerance_pct >>\,\%, pas une
probabilité.<% else %> Entre la première et la dernière colonne, << plan_band_word >>.<% endif %>}

\vspace{7mm}
\noindent\begin{minipage}[t]{0.47\linewidth}
<% if faits.arrets %>\LLbloc{Le risque des arrêts}\vspace{2.5mm}
{\raggedright\fontsize{9.4}{15}\selectfont\color{LLText}<< faits.arrets >>\par}
<% endif %>\end{minipage}\hfill
\begin{minipage}[t]{0.47\linewidth}
\LLbloc{Deux scénarios}\vspace{2.5mm}
{\raggedright\fontsize{9.4}{15}\selectfont\color{LLText}<< faits.scenarios.moins >> << faits.scenarios.plus >>\par}
\end{minipage}
<% if target_requested %>
\vspace{5mm}
\LLbloc{Ton objectif}\vspace{2.5mm}
{\fontsize{9.4}{15}\selectfont
Tu as demandé un plan pour \textbf{<< target_hm >>} : \textbf{<< target_regime_label >>}.
Il faudrait tenir << target_required_v >>\,km/h ajustés<% if target_vc_pct %>, soit
<< target_vc_pct >>\,\% de ta vitesse critique<% endif %><% if target_gap_pct %>, ce qui te situe
<< target_gap_pct >>\,\% plus <% if target_faster_than_central %>rapide<% else %>lent<% endif %>
que la prédiction<% endif %>.
<% if not target_plan_ok %>\textbf{Pas de plan sur cet objectif.} Cette cible sort de ce que tes données permettent : un plan calé dessus ferait partir trop vite et coûterait la fin de course. Le plan ci-dessus reste ancré sur la prédiction ; l'écart chiffré est un objectif d'entraînement pour la saison.
<% else %>Ce plan répartit au mieux la durée que tu as choisie en respectant ta courbe de fatigue ; il ne la rend pas tenable. La référence de ce qui est probable reste la prédiction et ses bornes de sécurité.
<% endif %>\par}
<% endif %>% LL:END page-plan

% =====================================================================
% LL:BEGIN page-preuve
\LLpage{Ton profil}

{\color{LLText}\hrule height 0.4pt}\vspace{7pt}
<% for l in profil_lignes %><% if loop.last %>\LLprofilfin<% else %>\LLprofilligne<% endif %>{<< l.label >>}{<< l.value >>}{<< l.texte >>}
<% endfor %>
<% if faits.intensites %>\vspace{6mm}
\LLbloc{L'intensité}\vspace{3mm}
\noindent\begin{minipage}[c]{0.60\linewidth}
{\fontsize{9.4}{15}\selectfont << faits.intensites.phrase >>\par}
\vspace{2mm}
{\fontsize{8.6}{13}\selectfont\color{LLSoft}<< faits.intensites.rappel >>\par}
\end{minipage}\hfill
\begin{minipage}[c]{0.34\linewidth}
\LLbarreintensite{<< faits.intensites.barre.mini >>}{<< faits.intensites.barre.maxi >>}{<< faits.intensites.barre.course >>}{<< faits.intensites.barre.mini_txt >>}{<< faits.intensites.barre.maxi_txt >>}{<< faits.intensites.barre.course_txt >>}
\end{minipage}
<% endif %>
\vspace{6mm}
\LLbloc{La validation croisée}\vspace{3mm}
<% if has_cv %>\noindent\begin{minipage}[t]{0.35\linewidth}\vspace{0pt}
\includegraphics[width=\linewidth]{figures/validation.png}
\end{minipage}\hfill
\begin{minipage}[t]{0.61\linewidth}\vspace{0pt}
{\fontsize{9.4}{15}\selectfont\color{LLText}<< caption_validation >>\par\vspace{3mm}
<< honesty >><% if width_prescription %> << width_prescription >><% endif %>\par}
\vspace{3mm}
\setlength{\fboxsep}{9pt}\setlength{\fboxrule}{0.4pt}%
\noindent{\color{LLHairline}\fbox{\color{LLText}\begin{minipage}{\dimexpr\linewidth-20pt\relax}
  {\LLsemiboldfont\fontsize{7.5}{10}\selectfont\color{LLText}\LLtracked{\MakeUppercase{Les limites}}\par}
  \vspace{2mm}
  {\fontsize{8.6}{13}\selectfont\color{LLSoft}<% for l in limits_short %>\textbf{\color{LLText}<< l.lead >>} \textemdash{} << l.short >><% if not loop.last %>\par{}<% endif %>
<% endfor %>\par}
\end{minipage}}}
\end{minipage}
<% else %>{\fontsize{9.4}{15}\selectfont\color{LLText}Moins de trois vrais ultras : la validation
croisée n'est pas calculable et la prédiction repose sur une extrapolation (<< regime_label >>).
Un ordre de grandeur, pas une cible ferme.\par}
\vspace{3mm}
\setlength{\fboxsep}{9pt}\setlength{\fboxrule}{0.4pt}%
\noindent{\color{LLHairline}\fbox{\color{LLText}\begin{minipage}{\dimexpr\linewidth-20pt\relax}
  {\LLsemiboldfont\fontsize{7.5}{10}\selectfont\color{LLText}\LLtracked{\MakeUppercase{Les limites}}\par}
  \vspace{2mm}
  {\fontsize{8.6}{13}\selectfont\color{LLSoft}<% for l in limits_short %>\textbf{\color{LLText}<< l.lead >>} \textemdash{} << l.short >><% if not loop.last %>\par{}<% endif %>
<% endfor %>\par}
\end{minipage}}}
<% endif %>
\vspace{6mm}
\LLbloc{Les hypothèses}\vspace{2.5mm}
\noindent\begin{minipage}[t]{0.83\linewidth}\vspace{0pt}
  {\fontsize{8.6}{13}\selectfont\color{LLSoft}\ignorespaces
  <% for a in assumptions %><< a >><% if not loop.last %> <% endif %><% endfor %>
  Le code ouvre l'annexe : méthode, calibration, courbe record, plan complet, et le
  formulaire qui personnalise ton tableau de marche. Sans téléphone,
  {\LLmonofont\fontsize{7.6}{10}\selectfont\color{LLPrimaryDark}\url{<< annex_url >>}}\par}
\end{minipage}\hfill
\begin{minipage}[t]{0.14\linewidth}\vspace{0pt}\raggedleft
  \LLqr{<< annex_url >>}
\end{minipage}
% LL:END page-preuve

\end{document}
