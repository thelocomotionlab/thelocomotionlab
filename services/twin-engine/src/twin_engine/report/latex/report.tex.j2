% Gabarit du rapport Locomotion Twin v2 (classe locomotionreport, Ubuntu Sans).
% Délimiteurs Jinja : chevrons doubles (variables), chevron-pourcent (blocs), chevron-dièse
% (commentaires) — rendu par twin_engine.report.render. Six pages : couverture · ta course en une page · le plan (deux
% pages) · ton profil · pourquoi tu peux y croire. Aucun résumé, aucune table des matières,
% aucun chiffre en dur sur les deux premières pages : tout vient du contexte calculé
% (tests/test_report_v2.py le vérifie entre les marqueurs LL:BEGIN / LL:END).
\documentclass{locomotionreport}

\renewcommand{\LLCoverLogoPath}{assets/logo_primary_deep}
\renewcommand{\LLHeaderLogoPath}{assets/logo_full_white}

\captionsetup{justification=raggedright, singlelinecheck=false}
\addbibresource{references.bib}

% LL:BEGIN cover
\title{<< race_name >>}
\subtitle{<< length_km >>\,km \textperiodcentered{} << dplus_m >>\,m\,D+ \textperiodcentered{} << dminus_m >>\,m\,D−}
\author{The Locomotion Lab}
\date{<< report_date >>}
\reporttype{Rapport Locomotion Twin \textperiodcentered{} << report_version >>}
\reportref{<< report_ref >>}
\reportclient{<< athlete >>}
\coversentence{<< cover_sentence >>}
\coverbadge{<< confidence_word >>}{<< confidence_color >>}
\coververdict{<< verdict_sentence >>}

\begin{document}

\makecover
% LL:END cover

% =====================================================================
% LL:BEGIN une-page
\LLpage{Ta course en une page}{<< race_name >>}

\noindent\begin{minipage}[t]{0.315\linewidth}
  \LLkpi{<< pred_central >>}{Arrivée prédite}{<% if arrival_clock %>le << arrival_clock >><% else %>temps de course, départ à préciser<% endif %>}
\end{minipage}\hfill
\begin{minipage}[t]{0.315\linewidth}
  <% if plan_low %>\LLkpi{<< plan_low >> – << plan_high >>}{Fourchette de course}{<< plan_band_word >><% if arrival_window %> : << arrival_window >><% endif %>}<% else %>\LLkpi{<< interval_low >> – << interval_high >>}{Intervalle}{<< safety_word >>}<% endif %>
\end{minipage}\hfill
\begin{minipage}[t]{0.315\linewidth}
  \LLkpi{<< interval_low >> – << interval_high >>}{Bornes de sécurité}{<< safety_word >><% if arrival_safety_window %> : << arrival_safety_window >><% endif %>}
\end{minipage}

\vspace{6pt}
\begin{figure}[H]
  \centering
  \includegraphics[width=\linewidth]{figures/profil.png}
\end{figure}

\noindent\begin{minipage}[t]{0.47\linewidth}
  \LLetiquette{Le parcours}\par\vspace{3pt}
  << length_km >>\,km, << dplus_m >>\,m de D+ et << dminus_m >>\,m de D−, soit
  \textbf{<< deq_km >>\,km à plat} une fois la pente convertie en effort, en
  << n_segments >>~segments entre points de passage.<% if technicity_pct %> Technicité déclarée :
  +<< technicity_pct >>\,\%.<% endif %><% if start_time %> Départ << start_time >>.<% endif %>
\end{minipage}\hfill
\begin{minipage}[t]{0.47\linewidth}
  \LLetiquette{Ce que ça te demande}\par\vspace{3pt}
  <% if vc_fraction_pct %>Environ << vc_fraction_pct >>\,\% de ta vitesse critique, tenus avec une
  dérive maîtrisée<% if vc_low %> : la vitesse ne sera pas le sujet, l'endurance et le
  ravitaillement décideront<% else %> : la régularité et la durabilité décideront<% endif %>.<% else %>Une
  allure très loin de tout seuil : l'endurance, la durabilité et le ravitaillement décideront.<% endif %>
  <% if night_from_km %>Nuit du km\,<< night_from_km >> au km\,<< night_to_km >> environ : frontale.<% endif %>
  Modèle servi : << regime_label >>.
\end{minipage}

\begin{llverdict}[<< confidence_word >>]
<< verdict_sentence >>.\par\vspace{2pt}
<% for r in verdict_reasons %><< r >>\par
<% endfor %>\end{llverdict}
% LL:END une-page

% =====================================================================
\LLpage{Le plan}{Ton allure, segment par segment}

\textbf{Effort ajusté constant, dérive assumée.} Tu vises une vitesse \emph{ajustée à la pente}
constante : ralentir en montée, accélérer en descente, au même coût. Le plan part un peu au-dessus
de ta moyenne et finit un peu en dessous ($-$<< fade_pct >>\,\% du début à la fin), parce que
<< fade_evidence >>.
<% if target_mode %>\textbf{Sur ton objectif.} Le temps réparti ici est \textbf{ton objectif}
(<< target_hm >>), pas la prédiction : les fenêtres sont une \textbf{tolérance d'exécution} de
$\pm$<< target_tolerance_pct >>\,\% sur le temps cumulé, pas une probabilité. Pour mémoire,
le modèle te situe à \textbf{<< pred_central >>}.
<% endif %>

\textbf{Arrêts.} << stops_policy.sentence >>.<% if stops_budget %> À titre d'information : sur
<< stops_budget.n >> de tes ultras, tu t'arrêtes << stops_budget.rate_min_per_h >>\,min par heure
de mouvement, soit << stops_budget.hours_hm >> sur cette course si tu fais comme d'habitude ; le
plan n'en retranche que la politique ci-dessus, à toi de voir.<% endif %>

\begin{table}[H]
  \centering \scriptsize \setlength{\tabcolsep}{3.2pt}
  \LLzebra \renewcommand{\arraystretch}{1.3}
  \begin{tabular}{@{}clrrlccccp{34mm}@{}}
    \LLheaderrow
    \LLthead{\#} & \LLthead{Vers} & \LLthead{km} & \LLthead{v.\,aj.} & \LLthead{allure} & \LLthead{<% if target_mode %>au plus tôt<% else %>rapide<% endif %>} & \LLthead{central} & \LLthead{<% if target_mode %>au plus tard<% else %>prudent<% endif %>} & \LLthead{nuit} & \LLthead{consigne} \\
     & & & \scriptsize(km/h) & \scriptsize(/km) & & & & & \\
<% for s in plan_rows %>    << s.idx >> & << s.to >> & \LLnum{<< s.off1 >>} & \LLnum{<< s.vga >>} & \LLnum{<< s.pace >>} & \LLnum{<< s.fast >>} & \LLnum{\textbf{<< s.central >>}} & \LLnum{<< s.cautious >>} & <% if s.night %>$\bullet$<% endif %> & << s.consigne >> \\
<% endfor %>  \end{tabular}
  \caption{Trois scénarios de course, segment par segment : \emph{rapide} et \emph{prudent} sont
  les bornes de la <% if target_mode %>fenêtre de passage ($\pm$<< target_tolerance_pct >>\,\% du
  temps cumulé, tolérance d'exécution)<% else %>fourchette de course (<< plan_band_word >>)<% endif %>.
  Repère tôt la colonne qui te correspond et suis-la. $\bullet$ = section de nuit.}
\end{table}

Total : mouvement << t_move_h >> + arrêts << t_stops_h >> = horloge \textbf{<< t_clock_h >>}.<% if sun %> Soleil : lever << sun.sunrise >>, coucher << sun.sunset >>.<% endif %>

\begin{figure}[H]
  \centering
  \includegraphics[width=\linewidth]{figures/cumul.png}
  \caption{<< caption_cumul >>}
\end{figure}

<% if target_requested %>\LLtitre{Ton objectif face à ton jumeau}
Tu as demandé un plan pour \textbf{<< target_hm >>}. Le verdict : \textbf{<< target_regime_label >>}.
\begin{table}[H]
  \centering \small \setlength{\tabcolsep}{7pt}
  \LLzebra \renewcommand{\arraystretch}{1.28}
  \begin{tabular}{@{}lr@{}}
    \LLheaderrow
    \LLthead{Ce que l'objectif exige} & \LLthead{valeur} \\
    Vitesse ajustée moyenne à tenir & \LLnum{<< target_required_v >>}\,km/h \\
<% if target_vc_pct %>    Intensité correspondante & \LLnum{<< target_vc_pct >>}\,\% de ta vitesse critique \\
<% endif %><% if target_envelope_pct %>    Part de ton enveloppe d'endurance à cette durée & \LLnum{<< target_envelope_pct >>}\,\% \\
<% endif %><% if target_gap_pct %>    Écart avec la prédiction (<< pred_central >>) & << target_gap_pct >>\,\% plus <% if target_faster_than_central %>rapide<% else %>lent<% endif %> \\
<% endif %><% if target_speed_gain_pct %>    Vitesse à <% if target_faster_than_central %>gagner<% else %>céder<% endif %> vs ton niveau actuel & << target_speed_gain_pct >>\,\% \\
<% endif %>  \end{tabular}
\end{table}
<% if target_reasons %>\begin{itemize}[leftmargin=1.4em]
<% for r in target_reasons %>\item << r >>
<% endfor %>\end{itemize}
<% endif %><% if not target_plan_ok %>\begin{llattention}[Pas de plan sur cet objectif]
Cette cible sort de ce que tes données permettent : un plan calé dessus ferait partir trop vite
et coûterait la fin de course. Le plan ci-dessus reste ancré sur la prédiction ; l'écart chiffré
est un objectif d'entraînement pour la saison.
\end{llattention}
<% else %>\begin{llattention}[Ce plan suppose ton objectif tenable]
Il répartit au mieux la durée que tu as choisie, en respectant ta courbe de fatigue ;
il ne le rend pas tenable.
La référence de ce qui est probable reste la prédiction et ses bornes de sécurité.
\end{llattention}
<% endif %><% endif %>

