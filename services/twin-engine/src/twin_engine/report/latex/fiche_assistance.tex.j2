<% endfor %><% if finish_row %>    \textbf{<< finish_row.name >>} & \LLnum{<< finish_row.km >>} & \LLnum{<< finish_row.earliest >>} & \LLnum{\textbf{<< finish_row.central >>}} & \LLnum{<< finish_row.latest >>} & --- & <% if finish_row.night %>$\bullet$<% endif %> \\
