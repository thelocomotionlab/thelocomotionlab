% La feuille à emporter (rapport Locomotion Twin v3) : A4 paysage, recto-verso, détachable.
% Deux tableaux et rien d'autre — le tableau de marche au recto, celui de l'assistance au verso.
% Elle se compile seule (--feuille-seule) ou à côté du rapport : mêmes valeurs, même contexte
% calculé, aucun chiffre en dur.
\documentclass{locomotionreport}

\geometry{a4paper, landscape, top=20mm, bottom=16mm, left=11mm, right=11mm,
          headsep=7mm, footskip=10mm}

\LLheaddoc{<< race_name >>}
\pagestyle{LLfeuille}

\begin{document}

% =====================================================================
% LL:BEGIN feuille-recto
\vspace{5pt}
{\LLextraboldfont\fontsize{17}{20}\selectfont\color{LLDeep}Tableau de marche\par}
\vspace{9pt}

{\fontsize{9.4}{9.4}\selectfont\LLtableau
\setlength{\tabcolsep}{3pt}\renewcommand{\arraystretch}{2.0}
\begin{tabularx}{\linewidth}{|c|>{\centering\arraybackslash}p{34mm}|c|c|c|c|c|c|c|c|c|c|>{\centering\arraybackslash}p{26mm}|>{\centering\arraybackslash}X|}
  \hline
  \LLheaderrow
  \LLthead{\#} & \LLthead{Ravitaillement} & \LLthead{km} & \LLthead{seg.} & \LLthead{D+} & \LLthead{D−} & \LLthead{min/km} & \LLthead{<< clock_titles.fast >>} & \LLthead{<< clock_titles.central >>} & \LLthead{<< clock_titles.cautious >>} & \LLthead{arrêt} & \LLthead{nuit} & \LLthead{type de ravito} & \LLthead{Sur ce segment} \\
  \hline
<% for s in feuille_rows %><% if s.contact %>  \LLassist
<% endif %>  << s.idx >> & << s.to >> & \LLnum{<< s.km >>} & \LLnum{<< s.seg_km >>} & <% if s.strong_dplus %>\LLfort{<< s.dplus >>}<% else %>\LLnum{<< s.dplus >>}<% endif %> & <% if s.strong_dminus %>\LLfort{<< s.dminus >>}<% else %>\LLnum{<< s.dminus >>}<% endif %> & \LLnum{<< s.pace >>} & \LLnum{<% if s.fast.day %><< s.fast.day >> <% endif %><< s.fast.hour >>} & \LLprevu{\LLnum{<% if s.central.day %><< s.central.day >> <% endif %><< s.central.hour >>}} & \LLnum{<% if s.cautious.day %><< s.cautious.day >> <% endif %><< s.cautious.hour >>} & <% if s.stop %>\LLnum{<< s.stop >>'}<% endif %> & <% if s.night %>\LLnuit<% endif %> & \LLcasevide & << s.marche >> \\
  \hline
<% endfor %>\end{tabularx}\par}
% LL:END feuille-recto

% =====================================================================
% LL:BEGIN feuille-verso
\clearpage
\vspace{5pt}
{\LLextraboldfont\fontsize{17}{20}\selectfont\color{LLDeep}Assistance\par}
\vspace{9pt}

{\fontsize{10.5}{10.5}\selectfont\LLtableau
\setlength{\tabcolsep}{6pt}\renewcommand{\arraystretch}{2.4}
\begin{tabularx}{\linewidth}{|>{\centering\arraybackslash}p{52mm}|c|c|c|c|>{\centering\arraybackslash}X|}
  \hline
  \LLheaderrow
  \LLthead{Assistance} & \LLthead{km} & \LLthead{au plus tôt} & \LLthead{prévu} & \LLthead{au plus tard} & \LLthead{À prévoir} \\
  \hline
<% for c in crew_rows %>  \LLassist
  << c.name >> & \LLnum{<< c.km >>} & \LLnum{<< c.earliest >>} & \LLprevu{\LLnum{<< c.central >>}} & \LLnum{<< c.latest >>} & <% if c.note %><< c.note >><% else %>\LLcasevide<% endif %> \\
  \hline
<% endfor %><% if finish_row %>  << finish_row.name >> & \LLnum{<< finish_row.km >>} & \LLnum{<< finish_row.earliest >>} & \LLprevu{\LLnum{<< finish_row.central >>}} & \LLnum{<< finish_row.latest >>} & \LLcasevide \\
  \hline
<% endif %>\end{tabularx}\par}
% LL:END feuille-verso

\end{document}
