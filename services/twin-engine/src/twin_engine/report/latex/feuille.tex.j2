% La feuille à emporter : A4 paysage, recto-verso, détachable, puis les fiches d'assistance
% à découper (A4 portrait). Le recto est le tableau de marche, le verso celui de l'assistance,
% la planche est une fiche par poste. Colonnes à largeur fixe — c'est ce qui rend la grille
% régulière. Elle se compile seule (--feuille-seule) ou à côté du rapport : mêmes valeurs,
% même contexte calculé, aucun chiffre en dur.
\documentclass{locomotionreport}

\LLheaddoc{<< race_name >>}
\pagestyle{LLfeuille}

% Largeurs de la grille : une seule pour les chiffres, une seule pour les heures, et la
% dernière colonne prend ce qui reste — c'est ce qui permet de composer TOUTES les colonnes
% en « m » (centrage vertical), ce que le X de tabularx ne sait pas faire.
\newlength{\LLchiffre} \setlength{\LLchiffre}{11.5mm}
\newlength{\LLheure}   \setlength{\LLheure}{24mm}
\newlength{\LLmarche}  % « sur ce segment », au recto
\newlength{\LLaprevoir}% « à prévoir », au verso
<% if nutrition %>\newlength{\LLnutri} \setlength{\LLnutri}{20mm}
<% endif %>% Les deux largeurs restantes se mesurent APRÈS le \tabcolsep de leur tableau :
% sinon elles mesurent la gouttière par défaut et la dernière colonne se ratatine.
\newcommand{\LLgrillemarche}{%
  \setlength{\LLmarche}{\dimexpr\linewidth - 1.1mm - 5.5mm - 46mm - 4\LLchiffre - 3\LLheure
    - 9mm<% if nutrition %> - \LLnutri<% endif %> - <% if nutrition %>23<% else %>21<% endif %>\tabcolsep
    - <% if nutrition %>13<% else %>12<% endif %>\arrayrulewidth\relax}}
\newcommand{\LLgrilleassistance}{%
  \setlength{\LLaprevoir}{\dimexpr\linewidth - 62mm - 18mm - 38mm - 40mm - 38mm
    - 12\tabcolsep - 7\arrayrulewidth\relax}}

% \LLtitrefeuille{titre}{ce qu'il faut savoir à droite}
\newcommand{\LLtitrefeuille}[2]{%
  \noindent\hbox to \linewidth{%
    {\LLsemiboldfont\fontsize{21}{24}\selectfont\color{LLText}#1}\hfill
    \begin{minipage}[b]{0.56\linewidth}\raggedleft
      {\fontsize{9}{13}\selectfont\color{LLSoft}#2\par}\end{minipage}}\par
  \vspace{3.5mm}}

\geometry{a4paper, landscape, top=20mm, bottom=17mm, left=14.8mm, right=14.8mm,
          headsep=6mm, footskip=11mm}

% Chaque bloc pose son propre air : le ressaut de paragraphe global ferait
% doublon avec les \vspace des macros de page.
\setlength{\parskip}{0pt}

\begin{document}

% =====================================================================
% LL:BEGIN feuille-recto
\LLpiedlegende{Colonnes horaires : \textcolor{LLPrimary}{sauge} = rapide,
\textcolor{LLDeep}{terracotta} = centrale, \textcolor{LLAccentDark}{ambre} = prudent
\textperiodcentered{} \LLtraitlegende{LLDeep} filet en marge : assistance autorisée
\textperiodcentered{} \LLnuitpoint{} point d'encre : segment de nuit \textperiodcentered{}
cases vides : de la place pour écrire.}
\LLtitrefeuille{Tableau de marche}{<% if start_time %>Départ << start_time >> \textperiodcentered{} <% endif %><< length_km >>\,km \textperiodcentered{} << dplus_m >>\,m\,D+}

\LLcadredecoupe{%
{\fontsize{11.25}{11.25}\selectfont\LLtableau
\setlength{\tabcolsep}{2.4pt}\renewcommand{\arraystretch}{1.85}
\LLgrillemarche
\begin{tabular}{|@{}>{\LLcell}m{1.1mm}@{}>{\LLcell\fontsize{9}{11}\selectfont\color{LLSoft}}m{5.5mm}|>{\LLcellg}m{46mm}|>{\LLcell}m{\LLchiffre}|>{\LLcell}m{\LLchiffre}|>{\LLcell}m{\LLchiffre}|>{\LLcell}m{\LLchiffre}|>{\columncolor{LLColRapide}\LLcell\color{LLSoft}}m{\LLheure}|>{\columncolor{LLColCentrale}\LLcell\LLsemiboldfont}m{\LLheure}|>{\columncolor{LLColPrudent}\LLcell\color{LLSoft}}m{\LLheure}|>{\LLcell\fontsize{9}{11}\selectfont\color{LLSoft}}m{9mm}|<% if nutrition %>>{\LLcell}m{\LLnutri}|<% endif %>>{\LLcell\fontsize{9}{11}\selectfont\color{LLSoft}}m{\LLmarche}|}
  \LLfilet{<% if nutrition %>13<% else %>12<% endif %>}
  & {\normalsize\color{LLText}\LLtete{\#}} & \LLtete{Ravitaillement} & \LLtete{km} & \LLtete{seg.} & \LLtete{D+} & \LLtete{D−} & \LLtetehoraire{LLPrimary}{<< clock_titles.fast >>} & \LLtetehoraire{LLDeep}{<< clock_titles.central >>} & \LLtetehoraire{LLAccent}{<< clock_titles.cautious >>} & \LLtete{arrêt}<% if nutrition %> & \LLtete{eau / ravito}<% endif %> & \LLtete{Sur ce segment} \\
  \LLfilet{<% if nutrition %>13<% else %>12<% endif %>}
<% for s in feuille_rows %>  <% if s.contact %>{\color{LLDeep}\LLmargecrew}<% endif %> & << s.idx >> & \LLnomseg{<% if s.contact %>\LLfort{<< s.to >>}<% else %><< s.to >><% endif %>}{<% if s.night %>\LLnuitpoint<% endif %>} & << s.km >> & << s.seg_km >> & <% if s.strong_dplus %>\LLfort{<< s.dplus >>}<% else %><< s.dplus >><% endif %> & <% if s.strong_dminus %>\LLfort{<< s.dminus >>}<% else %><< s.dminus >><% endif %> & <% if s.fast.day %><< s.fast.day >> <% endif %><< s.fast.hour >> & <% if s.central.day %><< s.central.day >> <% endif %><< s.central.hour >> & <% if s.cautious.day %><< s.cautious.day >> <% endif %><< s.cautious.hour >> & <% if s.stop %><< s.stop >>'<% endif %><% if nutrition %> & \LLcasevide<% endif %> & <% if s.marche %>\LLtient{\linewidth}{\mbox{<< s.marche >>}}<% else %>\LLcaseecrire<% endif %> \\
  \LLfilet{<% if nutrition %>13<% else %>12<% endif %>}
<% endfor %>\end{tabular}\par}}
% LL:END feuille-recto

% =====================================================================
% LL:BEGIN feuille-verso
\clearpage
\LLpiedlegende{Colonne \textcolor{LLDeep}{« prévu »} : l'heure que tu suis
\textperiodcentered{} \LLnuitpoint{} point d'encre : poste de nuit, prévoir de quoi éclairer
et avoir chaud.}
\LLtitrefeuille{Assistance}{« au plus tôt » et « au plus tard » sont les bornes de sécurité étalées le long du parcours, << safety_word >> y tient, arrivée comprise.}

\LLcadredecoupe{%
{\fontsize{12}{12}\selectfont\LLtableau
\setlength{\tabcolsep}{5pt}\renewcommand{\arraystretch}{3.1}
\LLgrilleassistance
\begin{tabular}{|>{\LLcell\LLsemiboldfont\fontsize{14.25}{16}\selectfont}m{62mm}|>{\LLcell\color{LLSoft}}m{18mm}|>{\LLcell\color{LLSoft}}m{38mm}|>{\columncolor{LLColCentrale}\LLcell\LLsemiboldfont\fontsize{15.75}{17}\selectfont}m{40mm}|>{\LLcell\color{LLSoft}}m{38mm}|>{\LLcell\fontsize{10.5}{12}\selectfont\color{LLSoft}}m{\LLaprevoir}|}
  \LLfilet{6}
  {\normalsize\LLtete{Assistance}} & {\normalsize\color{LLText}\LLtete{km}} & {\normalsize\color{LLText}\LLtete{au plus tôt}} & \LLtetehoraire{LLDeep}{prévu} & {\normalsize\color{LLText}\LLtete{au plus tard}} & {\normalsize\color{LLText}\LLtete{À prévoir}} \\
  \LLfilet{6}
<% for c in crew_rows %>  \LLnomseg{<< c.name >>}{<% if c.night %>\LLnuitpoint<% endif %>} & << c.km >> & << c.earliest >> & << c.central >> & << c.latest >> & <% if c.note %><< c.note >><% else %>\LLcaseecrire<% endif %> \\
  \LLfilet{6}
<% endfor %><% if finish_row %>  \LLnomseg{<< finish_row.name >>}{<% if finish_row.night %>\LLnuitpoint<% endif %>} & << finish_row.km >> & << finish_row.earliest >> & << finish_row.central >> & << finish_row.latest >> & \LLcaseecrire \\
  \LLfilet{6}
<% endif %>\end{tabular}\par}}
% LL:END feuille-verso

\end{document}
