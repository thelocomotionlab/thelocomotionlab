\section{Vos données personnelles}

\textbf{Responsable de traitement :} \VAR{responsable.nom},
\VAR{responsable.email}.

\textbf{Finalités et bases légales.} Organisation de l'atelier et sécurité des
participant·e·s, sur la base de l'intérêt légitime du responsable ; diffusion de
votre image, sur la base de votre consentement.

\textbf{Données collectées.} Nom, prénom, courriel, téléphone, contact
d'urgence, attestation de santé (sans le détail de vos réponses), choix relatif
au droit à l'image, horodatage de validation.

\textbf{Durées de conservation.}

\begin{table}[h]
  \centering
  \LLzebra
  \renewcommand{\arraystretch}{1.35}
  \begin{tabular}{@{}p{0.42\linewidth}p{0.24\linewidth}p{0.28\linewidth}@{}}
    \LLheaderrow
    \LLthead{Donnée} & \LLthead{Durée} & \LLthead{Motif} \\
    Fiche signée (information, consignes, attestation de santé)
      & \LLnum{10 ans} & Prescription en dommage corporel \\
    Coordonnées de contact courant
      & \LLnum{12 mois} & Après le dernier atelier \\
    Autorisation d'image
      & \LLnum{Durée de diffusion} & Puis suppression \\
    Commentaire libre de santé
      & \LLnum{Fin de l'atelier} & Suppression immédiate \\
  \end{tabular}
\end{table}

\textbf{Destinataires.} Aucun. Vos données ne sont ni transmises ni revendues.

\textbf{Vos droits.} Accès, rectification, effacement, limitation, opposition,
portabilité — par simple courriel à \VAR{responsable.email}. Vous pouvez
introduire une réclamation auprès de la CNIL.

