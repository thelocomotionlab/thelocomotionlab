\section{Droit à l'image}

\begin{llnote}[Sans effet sur votre participation]
Votre réponse ci-dessous est libre. Un refus n'empêche en rien votre
participation à l'atelier et n'entraîne aucune conséquence.
\end{llnote}

\noindent\VAR{coche(image.autorise)}\,\begin{minipage}[t]{0.92\linewidth}
\textbf{J'autorise} \VAR{responsable.nom} à me photographier ou me filmer
pendant l'atelier et à diffuser ces images sur \VAR{image.supports},
pour une durée de \VAR{image.duree}, à des fins de présentation de l'activité,
sans contrepartie financière.
\BLOCK{if mineur.actif}
Ce choix est exprimé par le représentant légal, pour le mineur.
\BLOCK{endif}
\end{minipage}

\vspace{1.5mm}
\noindent\VAR{coche(image.refuse)}\,\begin{minipage}[t]{0.92\linewidth}
\textbf{Je n'autorise pas} la diffusion de mon image.
\end{minipage}

\vspace{1.5mm}
\noindent{\small\color{LLCaption} Vous pouvez retirer cette autorisation à tout
moment en écrivant à \VAR{responsable.email}, sans avoir à motiver votre
demande.}

