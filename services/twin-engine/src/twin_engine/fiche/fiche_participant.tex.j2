\BLOCK{for question in sante.questions}
  \item \VAR{question}
\BLOCK{endfor}
\end{enumerate}

\vspace{1.5mm}
\begin{llattention}[Si vous avez répondu « oui » à au moins une question]
Consultez un médecin avant de participer. Vous pouvez tout à fait participer
ensuite : il s'agit d'un avis médical, pas d'une exclusion.
\end{llattention}

