# Environnements virtuels & caches Python
.venv/
.venv-*/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.mypy_cache/

# Dossier de données LOCAL (volume monté en prod) : archives transitoires, jobs.sqlite,
# sorties (PDF/figures). JAMAIS committé — données utilisateur, purgées après analyse.
data/
local-data/

# Archives d'entraînement réelles déposées pour test (perso/privé, jamais committées).
# NB : les petits échantillons de test vivent sous tests/**/fixtures/ et sont committés
# délibérément — on n'ignore donc PAS *.fit/*.gpx globalement, seulement ces dossiers.
incoming/

# Cas de validation RÉELS (archives perso Coros/Strava + traces) — données PRIVÉES
# (positions GPS, domicile…), JAMAIS committées. C'est ici que tu déposes tes données
# de validation, ex. _seed/cas_validation/Val_Nice_24_06_2026/.
_seed/cas_validation/
